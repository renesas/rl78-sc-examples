    <E2Lite>
        <OperatingFrequency>8.000000</OperatingFrequency>
    </E2Lite>
    <LogFile>
        <LoggingEnabled>_ 0</LoggingEnabled>
        <LogFile>_ "$PROJ_DIR$\LogFile1.log"</LogFile>
