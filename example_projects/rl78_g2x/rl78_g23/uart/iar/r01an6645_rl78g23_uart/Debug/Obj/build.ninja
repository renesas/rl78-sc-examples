#Generating source browse information for project r01an6645_rl78g23_uart


#Abbreviations
cc = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.5\common\bin\SourceIndexer.exe
ll = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.5\common\bin\PbdLink.exe
bd = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.5\common\bin\makeBrowseData.exe



#Rules
rule index
  depfile = $out.dep
  command = $cc -out=$out -f $in
rule link
  command = $ll -M $out $in
rule browsedata
  command = $bd $in -output  $out



#Build steps
build Config_UART0.pbi : index Config_UART0.xcl
build Config_UART0_user.pbi : index Config_UART0_user.xcl
build r_cg_lvd_common.pbi : index r_cg_lvd_common.xcl
build r_cg_lvd_common_user.pbi : index r_cg_lvd_common_user.xcl
build r_cg_sau_common.pbi : index r_cg_sau_common.xcl
build r_cg_systeminit.pbi : index r_cg_systeminit.xcl
build hdwinit.pbi : index hdwinit.xcl
build r_bsp_init.pbi : index r_bsp_init.xcl
build r_bsp_common.pbi : index r_bsp_common.xcl
build mcu_clocks.pbi : index mcu_clocks.xcl
build vecttbl.pbi : index vecttbl.xcl
build main.pbi : index main.xcl
build r01an6645_rl78g23_uart_part0.pbi : link Config_UART0.pbi Config_UART0_user.pbi r_cg_lvd_common.pbi
build r01an6645_rl78g23_uart_part1.pbi : link r_cg_lvd_common_user.pbi r_cg_sau_common.pbi r_cg_systeminit.pbi
build r01an6645_rl78g23_uart_part2.pbi : link hdwinit.pbi r_bsp_init.pbi r_bsp_common.pbi
build r01an6645_rl78g23_uart_part3.pbi : link mcu_clocks.pbi vecttbl.pbi main.pbi
build r01an6645_rl78g23_uart.pbd : link r01an6645_rl78g23_uart_part0.pbi r01an6645_rl78g23_uart_part1.pbi r01an6645_rl78g23_uart_part2.pbi r01an6645_rl78g23_uart_part3.pbi
build r01an6645_rl78g23_uart.pbw : browsedata r01an6645_rl78g23_uart.pbd


