#Generating source browse information for project r01an5618-rl78g23-rtc


#Abbreviations
cc = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.5\common\bin\SourceIndexer.exe
ll = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.5\common\bin\PbdLink.exe
bd = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.5\common\bin\makeBrowseData.exe



#Rules
rule index
  depfile = $out.dep
  command = $cc -out=$out -f $in
rule link
  command = $ll -M $out $in
rule browsedata
  command = $bd $in -output  $out



#Build steps
build Config_IICA0.pbi : index Config_IICA0.xcl
build Config_IICA0_user.pbi : index Config_IICA0_user.xcl
build Config_PORT.pbi : index Config_PORT.xcl
build Config_PORT_user.pbi : index Config_PORT_user.xcl
build Config_RTC.pbi : index Config_RTC.xcl
build Config_RTC_user.pbi : index Config_RTC_user.xcl
build r_cg_iica_common.pbi : index r_cg_iica_common.xcl
build r_cg_rtc_common.pbi : index r_cg_rtc_common.xcl
build r_cg_systeminit.pbi : index r_cg_systeminit.xcl
build hdwinit.pbi : index hdwinit.xcl
build r_bsp_init.pbi : index r_bsp_init.xcl
build r_bsp_common.pbi : index r_bsp_common.xcl
build mcu_clocks.pbi : index mcu_clocks.xcl
build vecttbl.pbi : index vecttbl.xcl
build LCM_driver.pbi : index LCM_driver.xcl
build main.pbi : index main.xcl
build r01an5618-rl78g23-rtc_part0.pbi : link Config_IICA0.pbi Config_IICA0_user.pbi Config_PORT.pbi Config_PORT_user.pbi
build r01an5618-rl78g23-rtc_part1.pbi : link Config_RTC.pbi Config_RTC_user.pbi r_cg_iica_common.pbi r_cg_rtc_common.pbi
build r01an5618-rl78g23-rtc_part2.pbi : link r_cg_systeminit.pbi hdwinit.pbi r_bsp_init.pbi r_bsp_common.pbi
build r01an5618-rl78g23-rtc_part3.pbi : link mcu_clocks.pbi vecttbl.pbi LCM_driver.pbi main.pbi
build r01an5618-rl78g23-rtc.pbd : link r01an5618-rl78g23-rtc_part0.pbi r01an5618-rl78g23-rtc_part1.pbi r01an5618-rl78g23-rtc_part2.pbi r01an5618-rl78g23-rtc_part3.pbi
build r01an5618-rl78g23-rtc.pbw : browsedata r01an5618-rl78g23-rtc.pbd


