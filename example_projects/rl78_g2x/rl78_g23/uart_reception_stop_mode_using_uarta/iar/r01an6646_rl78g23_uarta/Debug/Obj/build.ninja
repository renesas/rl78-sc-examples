#Generating source browse information for project r01an6646_rl78g23_uarta


#Abbreviations
cc = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.5\common\bin\SourceIndexer.exe
ll = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.5\common\bin\PbdLink.exe
bd = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.5\common\bin\makeBrowseData.exe



#Rules
rule index
  depfile = $out.dep
  command = $cc -out=$out -f $in
rule link
  command = $ll -M $out $in
rule browsedata
  command = $bd $in -output  $out



#Build steps
build Config_KR.pbi : index Config_KR.xcl
build Config_KR_user.pbi : index Config_KR_user.xcl
build Config_TAU0_0.pbi : index Config_TAU0_0.xcl
build Config_TAU0_0_user.pbi : index Config_TAU0_0_user.xcl
