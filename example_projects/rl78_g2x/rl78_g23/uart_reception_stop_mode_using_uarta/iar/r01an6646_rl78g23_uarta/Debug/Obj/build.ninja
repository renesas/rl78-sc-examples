build hdwinit.pbi : index hdwinit.xcl
build r_bsp_init.pbi : index r_bsp_init.xcl
build r_bsp_common.pbi : index r_bsp_common.xcl
build mcu_clocks.pbi : index mcu_clocks.xcl
build vecttbl.pbi : index vecttbl.xcl
build main.pbi : index main.xcl
build r01an6646_rl78g23_uarta_part0.pbi : link Config_KR.pbi Config_KR_user.pbi Config_TAU0_0.pbi Config_TAU0_0_user.pbi
build r01an6646_rl78g23_uarta_part1.pbi : link Config_UARTA0.pbi Config_UARTA0_user.pbi r_cg_lvd_common.pbi r_cg_lvd_common_user.pbi
build r01an6646_rl78g23_uarta_part2.pbi : link r_cg_systeminit.pbi r_cg_tau_common.pbi r_cg_uarta_common.pbi hdwinit.pbi
build r01an6646_rl78g23_uarta_part3.pbi : link r_bsp_init.pbi r_bsp_common.pbi mcu_clocks.pbi vecttbl.pbi
build r01an6646_rl78g23_uarta_part4.pbi : link main.pbi
build r01an6646_rl78g23_uarta.pbd : link r01an6646_rl78g23_uarta_part0.pbi r01an6646_rl78g23_uarta_part1.pbi r01an6646_rl78g23_uarta_part2.pbi r01an6646_rl78g23_uarta_part3.pbi r01an6646_rl78g23_uarta_part4.pbi
