#Generating source browse information for project r01an5523


#Abbreviations
cc = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.5\common\bin\SourceIndexer.exe
ll = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.5\common\bin\PbdLink.exe
bd = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.5\common\bin\makeBrowseData.exe



#Rules
rule index
  depfile = $out.dep
  command = $cc -out=$out -f $in
rule link
  command = $ll -M $out $in
rule browsedata
  command = $bd $in -output  $out



#Build steps
build Config_ADC.pbi : index Config_ADC.xcl
build Config_ADC_user.pbi : index Config_ADC_user.xcl
build r_cg_ad_common.pbi : index r_cg_ad_common.xcl
build r_cg_systeminit.pbi : index r_cg_systeminit.xcl
build hdwinit.pbi : index hdwinit.xcl
build r_bsp_init.pbi : index r_bsp_init.xcl
build r_bsp_common.pbi : index r_bsp_common.xcl
build mcu_clocks.pbi : index mcu_clocks.xcl
build vecttbl.pbi : index vecttbl.xcl
build main.pbi : index main.xcl
build r01an5523_part0.pbi : link Config_ADC.pbi Config_ADC_user.pbi r_cg_ad_common.pbi
build r01an5523_part1.pbi : link r_cg_systeminit.pbi hdwinit.pbi r_bsp_init.pbi
build r01an5523_part2.pbi : link r_bsp_common.pbi mcu_clocks.pbi vecttbl.pbi
build r01an5523_part3.pbi : link main.pbi
build r01an5523.pbd : link r01an5523_part0.pbi r01an5523_part1.pbi r01an5523_part2.pbi r01an5523_part3.pbi
build r01an5523.pbw : browsedata r01an5523.pbd


