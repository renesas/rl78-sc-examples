#Generating source browse information for project r01an5598_rl78g23_uarta


#Abbreviations
cc = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.5\common\bin\SourceIndexer.exe
ll = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.5\common\bin\PbdLink.exe
bd = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.5\common\bin\makeBrowseData.exe



#Rules
rule index
  depfile = $out.dep
  command = $cc -out=$out -f $in
rule link
  command = $ll -M $out $in
rule browsedata
  command = $bd $in -output  $out



#Build steps
build Config_PORT.pbi : index Config_PORT.xcl
build Config_PORT_user.pbi : index Config_PORT_user.xcl
build Config_UARTA0.pbi : index Config_UARTA0.xcl
build Config_UARTA0_user.pbi : index Config_UARTA0_user.xcl
build r_cg_systeminit.pbi : index r_cg_systeminit.xcl
build r_cg_uarta_common.pbi : index r_cg_uarta_common.xcl
build hdwinit.pbi : index hdwinit.xcl
build r_bsp_init.pbi : index r_bsp_init.xcl
build r_bsp_common.pbi : index r_bsp_common.xcl
build mcu_clocks.pbi : index mcu_clocks.xcl
build vecttbl.pbi : index vecttbl.xcl
build main.pbi : index main.xcl
build r01an5598_rl78g23_uarta_part0.pbi : link Config_PORT.pbi Config_PORT_user.pbi Config_UARTA0.pbi
build r01an5598_rl78g23_uarta_part1.pbi : link Config_UARTA0_user.pbi r_cg_systeminit.pbi r_cg_uarta_common.pbi
build r01an5598_rl78g23_uarta_part2.pbi : link hdwinit.pbi r_bsp_init.pbi r_bsp_common.pbi
build r01an5598_rl78g23_uarta_part3.pbi : link mcu_clocks.pbi vecttbl.pbi main.pbi
build r01an5598_rl78g23_uarta.pbd : link r01an5598_rl78g23_uarta_part0.pbi r01an5598_rl78g23_uarta_part1.pbi r01an5598_rl78g23_uarta_part2.pbi r01an5598_rl78g23_uarta_part3.pbi
build r01an5598_rl78g23_uarta.pbw : browsedata r01an5598_rl78g23_uarta.pbd


