#Generating source browse information for project r01an5919-rl78g23-tmeasure


#Abbreviations
cc = D$:\IAREW_RL78\common\bin\SourceIndexer.exe
ll = D$:\IAREW_RL78\common\bin\PbdLink.exe
bd = D$:\IAREW_RL78\common\bin\makeBrowseData.exe



#Rules
rule index
  depfile = $out.dep
  command = $cc -out=$out -f $in
rule link
  command = $ll -M $out $in
rule browsedata
  command = $bd $in -output  $out



#Build steps
build Config_TAU0_0.pbi : index Config_TAU0_0.xcl
build Config_TAU0_0_user.pbi : index Config_TAU0_0_user.xcl
build r_cg_lvd_common.pbi : index r_cg_lvd_common.xcl
build r_cg_lvd_common_user.pbi : index r_cg_lvd_common_user.xcl
build r_cg_systeminit.pbi : index r_cg_systeminit.xcl
build r_cg_tau_common.pbi : index r_cg_tau_common.xcl
build hdwinit.pbi : index hdwinit.xcl
build r_bsp_init.pbi : index r_bsp_init.xcl
build r_bsp_common.pbi : index r_bsp_common.xcl
build mcu_clocks.pbi : index mcu_clocks.xcl
build vecttbl.pbi : index vecttbl.xcl
build main.pbi : index main.xcl
build r01an5919-rl78g23-tmeasure_part0.pbi : link Config_TAU0_0.pbi Config_TAU0_0_user.pbi r_cg_lvd_common.pbi
build r01an5919-rl78g23-tmeasure_part1.pbi : link r_cg_lvd_common_user.pbi r_cg_systeminit.pbi r_cg_tau_common.pbi
build r01an5919-rl78g23-tmeasure_part2.pbi : link hdwinit.pbi r_bsp_init.pbi r_bsp_common.pbi
build r01an5919-rl78g23-tmeasure_part3.pbi : link mcu_clocks.pbi vecttbl.pbi main.pbi
build r01an5919-rl78g23-tmeasure.pbd : link r01an5919-rl78g23-tmeasure_part0.pbi r01an5919-rl78g23-tmeasure_part1.pbi r01an5919-rl78g23-tmeasure_part2.pbi r01an5919-rl78g23-tmeasure_part3.pbi
build r01an5919-rl78g23-tmeasure.pbw : browsedata r01an5919-rl78g23-tmeasure.pbd


