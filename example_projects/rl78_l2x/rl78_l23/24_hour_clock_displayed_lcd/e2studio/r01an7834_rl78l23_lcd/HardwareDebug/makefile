	-$(file > clean_file.tmp, $(LINKER_OUTPUT_OUTPUTS) $(LIBRARY_GENERATOR_OUTPUTTYPE_OUTPUTS) $(CONVERTOR_OUTPUT_OUTPUTS) $(SMS_ASSEMBLER_H) $(OBJS) $(ALL_COMMON_DEPS) $(DSP_DEPS) $(DSP_UPPER_DEPS) $(OUTPUT_FILES))
	-@ xargs -P 2 -s 26000 -t -a clean_file.tmp $(RM)
	-@$(RM) clean_file.tmp
	@echo ''
	@echo 'Clean complete.'

